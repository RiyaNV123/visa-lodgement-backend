JWT_SECRET=change-this-to-a-random-string
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec
APPS_SCRIPT_SECRET=change-this-to-a-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# S3-primary / Drive-backup document pipeline (see s3-drive-sync-plan.md)
S3_ENDPOINT_URL=https://REPLACE_WITH_AIC_ENDPOINT
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=485-docs-primary
S3_REGION=us-east-1
SYNC_WORKER_POLL_SECONDS=20
SYNC_WORKER_MAX_RETRIES=5
SYNC_WORKER_STUCK_TIMEOUT_SECONDS=300

# Local OCR fallback for scanned documents (needs tesseract-ocr installed --
# `apt install tesseract-ocr` on Linux/the VPS, then leave this blank; on
# Windows it isn't on PATH, so point this at tesseract.exe directly).
TESSERACT_CMD=
